# =============================================================================
# Required — the app will not start without these.
# =============================================================================

# Postgres / Neon. Production must use the pooled URL with `pgbouncer=true`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# NextAuth. Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Field-level encryption (AES-256-GCM, base64-encoded 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without this, every PHI-encrypted column read/write throws.
APP_ENCRYPTION_KEY=""
# During a key rotation window, set versioned keys + active version. The
# encryption helper reads `<version>:` prefixes from existing ciphertexts;
# new writes use the active key. See src/workers/key-rotation.ts.
# APP_ENCRYPTION_KEY_V1=""
# APP_ENCRYPTION_KEY_V2=""
# APP_ENCRYPTION_KEY_VERSION="v2"

# =============================================================================
# Required for any real-world traffic (still optional for `npm run dev`)
# =============================================================================

# Anthropic — layer-4 language analysis + coordinator-draft replies. Without
# this, layer-4 falls back to neutral output and the per-veteran timeline
# surfaces a "language analysis unavailable" banner.
ANTHROPIC_API_KEY=""

# Resend — magic-link delivery + every transactional email. Without
# RESEND_API_KEY, every Notification row is marked SUPPRESSED with reason
# "RESEND_API_KEY not set (dev mode)" and no outbound email fires.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM_PLATFORM="Sentinel <noreply@platform.tld>"
EMAIL_FROM_PROGRAM="Sentinel <hello@platform.tld>"

# Web Push (VAPID). Generate once with `node scripts/gen-vapid.mjs` and
# commit the public key only into client config (server signs each push).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@platform.tld"

# Redis (Upstash recommended). Required in production for:
#   - BullMQ workers (notification fan-out, layer-4 AI, SLA monitor,
#     data retention, caseload reassignment)
#   - SSE pubsub for live triage queue + clinical desk + thread updates
#   - Distributed rate limiting (otherwise per-process in-memory)
# Without REDIS_URL: layer-4 is skipped, notifications stop dispatching,
# the live status indicators degrade to polling-only, and /api/readyz
# returns 503.
REDIS_URL=""
RATE_LIMIT_REDIS_URL=""

# Cron auth — required when using Vercel Cron to trigger
# /api/cron/checkin-invites. Sender must include
# `Authorization: Bearer ${CRON_SECRET}`. Vercel Cron does this automatically.
CRON_SECRET=""

# =============================================================================
# Optional — defaults are sensible
# =============================================================================

# Sentry / OTel. If unset, errors are logged via pino only. PII scrub is
# always on regardless of this value.
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.05"

# Auth UI label.
# AUTH_ISSUER="Sentinel"

# Worker concurrency overrides.
# LANGUAGE_ANALYSIS_CONCURRENCY="4"
# NOTIFICATION_CONCURRENCY="8"

# Logging level: trace | debug | info | warn | error | fatal
# Defaults to "info" in production, "debug" otherwise.
# LOG_LEVEL="info"

# Playwright — point at a running deployment to skip the auto-spawned dev
# server in CI. Empty for local runs.
# PLAYWRIGHT_BASE_URL=""

# Crisis-path E2E gating. Set to your test DB connection to enable
# tests/e2e/crisis-path.spec.ts. Skipped if unset.
# E2E_TEST_DATABASE_URL=""
# E2E_VETERAN_EMAIL="veteran@e2e.test"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Field-level encryption (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# Optional: rotate keys by setting versioned keys + active version
# APP_ENCRYPTION_KEY_V1=""
# APP_ENCRYPTION_KEY_V2=""
# APP_ENCRYPTION_KEY_VERSION="v2"

# Anthropic — used for layer 4 language analysis and coordinator-draft replies
ANTHROPIC_API_KEY=""

# Email (Resend, primary). Magic-link delivery + transactional email.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM_PLATFORM="Sentinel <noreply@platform.tld>"
EMAIL_FROM_PROGRAM="Sentinel <hello@platform.tld>"

# Web Push (VAPID). Generate keys once with `node scripts/gen-vapid.mjs`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:security@platform.tld"

# Redis. Required in production for:
#   - BullMQ workers (layer-4 AI analysis, notification fan-out, invitation cron)
#   - Distributed rate limiting (otherwise per-process in-memory)
# Without REDIS_URL, layer-4 AI analysis is skipped at submit time and the
# coordinator UI surfaces a degradation banner. /api/readyz returns 503.
REDIS_URL=""
RATE_LIMIT_REDIS_URL=""

# Cron auth — required when using Vercel Cron to trigger
# /api/cron/checkin-invites. The cron sender must include
# `Authorization: Bearer ${CRON_SECRET}`. Vercel Cron does this automatically.
CRON_SECRET=""

# Worker concurrency overrides (optional)
# LANGUAGE_ANALYSIS_CONCURRENCY="4"

# Logging level: trace | debug | info | warn | error | fatal
# Defaults to "info" in production, "debug" otherwise.
# LOG_LEVEL="info"

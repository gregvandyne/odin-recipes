# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Anthropic — used for layer 4 language analysis and coordinator-draft replies
ANTHROPIC_API_KEY=""

# Email (magic links + notifications). Use a transactional provider in prod.
EMAIL_FROM_PLATFORM="security@platform.tld"
EMAIL_FROM_PROGRAM="hello@platform.tld"
SMTP_URL=""

# Redis (notification queue)
REDIS_URL="redis://localhost:6379"

# Field-level encryption key for PHI/PII at rest. Rotate via documented runbook.
APP_ENCRYPTION_KEY=""
